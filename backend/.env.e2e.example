# Never use production data or production payment keys for E2E execution.
APP_ENV=e2e
DB_URL=mysql+aiomysql://USER:PASSWORD@HOST:3306/snagly_e2e

# Required only when running: python -m seeds.e2e
E2E_SEED_CONFIRMATION=SEED_E2E_DATA
E2E_PASSWORD=replace-with-a-unique-strong-e2e-password

# Test/sandbox values only. Keep real values in the hosting provider, never in Git.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-test-webhook-secret
